{
  "name": "omnichain-asset-bridge-with-governance",
  "version": "1.0.0",
  "private": true,
  "description": "Local omnichain asset bridge with governance recovery",
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:unit": "hardhat test tests/unit/chainA.test.js tests/unit/chainB.test.js",
    "test:e2e": "cross-env RUN_E2E=1 hardhat test tests/integration/bridge.e2e.test.js tests/integration/relayer-recovery.e2e.test.js",
    "deploy:chainA": "hardhat run scripts/deployChainA.js --network chainA",
    "deploy:chainB": "hardhat run scripts/deployChainB.js --network chainB",
    "deploy:all": "node scripts/deployAll.js",
    "relayer": "node relayer/src/index.js",
    "lock:chainA": "node scripts/interactionChainA.js",
    "burn:chainB": "node scripts/interactionChainB.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "cross-env": "^7.0.3",
    "hardhat": "^2.22.15"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2"
  }
}
